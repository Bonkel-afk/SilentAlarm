{
  "name": "silentuncle",
  "version": "1.0.0",
  "description": "SilentAlarm — Veterinary Clinic Alert System",
  "main": "main.js",
  "private": true,
  "scripts": {
    "dev": "concurrently -n SERVER,CLIENT,ELECTRON -c yellow,cyan,green --kill-others \"npm run dev --prefix server\" \"npm run dev --prefix client\" \"wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .\"",
    "build": "npm run build --prefix client",
    "start": "electron .",
    "server": "npm run start --prefix server",
    "dist": "npm run build && electron-builder",
    "dist:win": "cross-env NODE_ENV=production npm run build --prefix client && electron-builder --win",
    "dist:linux": "cross-env NODE_ENV=production npm run build --prefix client && electron-builder --linux"
  },
  "build": {
    "appId": "com.silentuncle.app",
    "productName": "SilentAlarm",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "client/dist/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "linux": {
      "target": "AppImage"
    },
    "mac": {
      "target": "dmg"
    }
  },
  "devDependencies": {
    "concurrently": "^7.6.0",
    "cross-env": "^7.0.3",
    "electron": "^40.7.0",
    "electron-builder": "^26.8.1",
    "wait-on": "^8.0.5"
  }
}
